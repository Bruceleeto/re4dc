static void file_prompt_bind(SsFileWork* fw)
{
    file_prompt_kind=RE4DC_PROMPT_UNKNOWN;
    if(pSys->language!=1 || fw->fileNo!=1 || fw->msgBase!=0 ||
       fw->page!=4 || fw->layout!=1 || fw->attr!=0x80054)return;
    Message* m=&cMes.mes[0];
    if(!m->m_pMes)return;
    const unsigned n=sizeof(prompt_camera_source)/sizeof(prompt_camera_source[0]);
    for(unsigned i=0;i<n;++i)if(m->m_pMes[i]!=prompt_camera_source[i])return;
    // Latch per original page setup. Never reinitialize text due to a pad poll.
    file_prompt_kind=re4dc_pad_prompt_kind(0,0);
    if(file_prompt_kind==RE4DC_PROMPT_DPAD)
        m->m_pMes=const_cast<u16*>(prompt_camera_dpad);
    else if(file_prompt_kind==RE4DC_PROMPT_SECOND_ANALOG)
        m->m_pMes=const_cast<u16*>(prompt_camera_second);
}

#endif

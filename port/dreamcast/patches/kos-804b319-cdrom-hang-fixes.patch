         return ERR_TIMEOUT;
     }
@@ -192,19 +199,23 @@ int cdrom_exec_cmd_timed(cd_cmd_code_t cmd, void *param, uint32_t timeout) {
     }
 
     if(cmd_response == CD_CMD_COMPLETED || cmd_response == CD_CMD_STREAMING) {
